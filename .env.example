# =============================================
# RAG Document Cataloger - Environment Variables
# =============================================

# --- AI Models (Best Free Models for High Quality) ---
# Generation model: google/flan-t5-xl (3B params) produces high-quality answers
# Alternatives: google/flan-t5-xxl (11B, best quality but slower), mistralai/Mistral-7B-Instruct-v0.2
HUGGINGFACE_MODEL="google/flan-t5-xl"

# Embedding model: BAAI/bge-base-en-v1.5 (state-of-the-art retrieval quality, 768 dimensions)
# Alternative: sentence-transformers/all-mpnet-base-v2
EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"

# Device for LLM generation: -1 for CPU, 0 for first GPU, 1 for second GPU, etc.
LLM_DEVICE="-1"

# --- Text Processing ---
CHUNK_SIZE="500"
CHUNK_OVERLAP="50"

# --- Authentication ---
# SECRET_KEY: Used for JWT token signing - generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=""

# --- Email Settings (Required for verification codes) ---
EMAIL_TEST_MODE="false"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

# --- AI LLM API Keys (Groq is tried first, Gemini is fallback) ---
# Groq API Key (free at https://console.groq.com/keys)
# Uses Llama 3.3 70B for AI answers and heading categorization
GROQ_API_KEY=""

# Gemini API Key (free at https://aistudio.google.com/apikey)
# Uses Gemini 2.0 Flash as fallback if Groq fails
GEMINI_API_KEY=""
